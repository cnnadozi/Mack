{
  "manifest_version": 3,
  "name": "Mack",
  "version": "0.1.0",
  "description": "Mack Chrome extension starter.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.elevenlabs.io/*"],
  "action": {
    "default_title": "Mack",
    "default_popup": "popup.html"
  }
}
