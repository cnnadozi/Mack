{
  "manifest_version": 3,
  "name": "Mack",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Simplify real website actions with AI guidance.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.gov.uk/*", "https://api.anthropic.com/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_title": "Activate Mack"
  }
}
